#!/bin/bash
#SBATCH --time=24:00:00
#SBATCH --job-name=Yelmo
#SBATCH --mail-type=END
#SBATCH --mail-type=FAIL
#SBATCH --mail-type=REQUEUE
#SBATCH --output=out.out
#SBATCH --error=out.err
#SBATCH --queue=short


export GMON_OUT_PREFIX=./gmon

ulimit -s unlimited
#ulimit -c unlimited
#ulimit -s unlimited
#ulimit -d unlimited
#ulimit -m unlimited
ulimit -v unlimited
#ulimit -f unlimited
ulimit -a

# Run the job
#srun ./yelmox.x yelmo_SPI_pd.nml 
./yelmox.x SPI_pat_pd.nml

